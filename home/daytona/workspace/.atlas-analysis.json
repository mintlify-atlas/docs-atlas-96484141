  "keyFeatures": [
    "JWT authentication with access/refresh token rotation",
    "Role-based access control (customer / admin)",
    "Product catalog with categories, subcategories, and image uploads",
    "Shopping cart with per-user persistence",
    "Order lifecycle management (pending → paid → fulfilled → shipped)",
    "Pluggable payment provider interface with mock implementation",
    "Discount code engine (percentage or fixed, with expiry and usage limits)",
    "BullMQ background job queues for order processing and notifications",
    "Next.js storefront with infinite-scroll product listing",
    "Admin dashboard for products, orders, stock, and users",
    "Global response envelope (status + data) via NestJS interceptor",
    "Rate limiting (100 req / 60 s) via @nestjs/throttler",
    "Multipart file uploads for product images served as static assets"
  ],
  "publicApiSurface": [
